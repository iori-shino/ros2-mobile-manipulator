<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="chassis_blue"><color rgba="0.16 0.30 0.48 1"/></material>
  <material name="arm_silver"><color rgba="0.72 0.76 0.80 1"/></material>
  <material name="joint_orange"><color rgba="0.92 0.48 0.12 1"/></material>
  <material name="rubber"><color rgba="0.14 0.15 0.17 1"/></material>
  <material name="sensor_dark"><color rgba="0.08 0.10 0.13 1"/></material>

  <!-- Masses are course-project estimates, not SolidWorks mass properties. -->
  <xacro:macro name="box_inertial" params="mass size xyz:='0 0 0'">
    <xacro:property name="d" value="${[float(v) for v in size.split()]}"/>
    <inertial>
      <origin xyz="${xyz}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(d[1]**2+d[2]**2)/12}" ixy="0" ixz="0"
               iyy="${mass*(d[0]**2+d[2]**2)/12}" iyz="0"
               izz="${mass*(d[0]**2+d[1]**2)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder inertia is about its local Z axis, rotated with origin rpy. -->
  <xacro:macro name="cylinder_inertial" params="mass radius length xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(3*radius**2+length**2)/12}" ixy="0" ixz="0"
               iyy="${mass*(3*radius**2+length**2)/12}" iyz="0"
               izz="${mass*radius**2/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="file xyz rpy material">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <mesh filename="package://mobile_manipulator_description/meshes/${file}.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="box_collision" params="size xyz:='0 0 0'">
    <collision><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry></collision>
  </xacro:macro>

  <xacro:macro name="cylinder_collision" params="radius length xyz:='0 0 0' rpy:='0 0 0'">
    <collision><origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="name parent child xyz rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
