<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensors" params="">
    <link name="lidar_link">
      <visual><geometry><cylinder radius="0.035" length="0.035"/></geometry><material name="sensor_dark"/></visual>
      <xacro:cylinder_collision radius="0.035" length="0.035"/>
      <xacro:cylinder_inertial mass="0.15" radius="0.035" length="0.035"/>
    </link>
    <xacro:fixed_joint name="lidar_joint" parent="base_link" child="lidar_link" xyz="-0.13 -0.08 0.1175"/>
    <!-- Front camera: approximate dimensions from the user's reference, in metres.
         Body bottom rests on the chassis top (z=0.04); lens faces +X.
         Rear battery housing remains part of base_plate.STL. -->
    <link name="camera_link">
      <visual><geometry><box size="0.04 0.09 0.06"/></geometry><material name="sensor_dark"/></visual>
      <visual>
        <origin xyz="0.0225 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="0.018" length="0.005"/></geometry>
        <material name="rubber"/>
      </visual>
      <visual>
        <origin xyz="0.025 0 0"/>
        <geometry><box size="0.0002 0.003 0.022"/></geometry>
        <material name="camera_lens_blue"><color rgba="0.05 0.55 0.8 1"/></material>
      </visual>
      <xacro:box_collision size="0.04 0.09 0.06"/>
      <xacro:box_inertial mass="0.08" size="0.04 0.09 0.06"/>
    </link>
    <xacro:fixed_joint name="camera_joint" parent="base_link" child="camera_link" xyz="0.175 0 0.07"/>
    <!-- Optical convention: Z forward, X right, Y down. Geometry only, no sensor plugins. -->
    <link name="camera_optical_frame"/>
    <xacro:fixed_joint name="camera_optical_joint" parent="camera_link" child="camera_optical_frame"
                       xyz="0.025 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </xacro:macro>
</robot>
